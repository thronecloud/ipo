# Reverse proxy for the server deployment (see docker-compose.prod.yml).
# SITE_ADDRESS and ADMIN_HASH come from the environment (.env, passed in via the
# caddy service's env_file). SITE_ADDRESS as a hostname enables automatic HTTPS;
# swapping to a real domain is just a .env change. ADMIN_HASH is a bcrypt hash
# from `caddy hash-password` — the plaintext never lives in the repo.
{$SITE_ADDRESS} {
	# The whole site is open, Engine Room read views included. Job mutations are
	# still guarded app-side by ADMIN_TOKEN (X-Admin-Token header) — without it
	# the API restricts job runs to localhost.
	reverse_proxy web:3000
}
